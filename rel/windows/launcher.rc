/*
 * Resources of Nunki.exe, compiled by `zig rc` from build_launcher.ps1.
 *
 * launcher_version.h is written by that script from the version in mix.exs
 * and is not committed.
 */

#include "launcher_version.h"

1 ICON "Nunki.ico"

1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION NUNKI_VER_MAJOR, NUNKI_VER_MINOR, NUNKI_VER_PATCH, 0
PRODUCTVERSION NUNKI_VER_MAJOR, NUNKI_VER_MINOR, NUNKI_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nunki"
            VALUE "FileDescription", "Nunki - the hall announcer"
            VALUE "FileVersion", NUNKI_VER_STRING
            VALUE "InternalName", "Nunki"
            VALUE "OriginalFilename", "Nunki.exe"
            VALUE "ProductName", "Nunki"
            VALUE "ProductVersion", NUNKI_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

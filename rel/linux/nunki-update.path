# The arbiter pressed "Download and install" on the Setup page: the program,
# which is not root and cannot replace itself, wrote the version it wants
# into this file. That is all it can do; nunki-update.service does the rest.

[Unit]
Description=Nunki - an update was asked for on the Setup page

[Path]
PathExists=/var/lib/nunki/update/request
Unit=nunki-update.service

[Install]
WantedBy=multi-user.target
